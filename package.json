{
  "name": "euler-platform",
  "version": "0.1.0",
  "bin": {
    "euler-platform": "bin/euler-platform.js"
  },
  "scripts": {
    "build": "tsc && npm run build:webpack",
    "build:webpack": "webpack --config packages/functions/webpack.config.js",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "bootstrap": "lerna bootstrap",
    "deploy": "npm run bootstrap && npm run build && cdk deploy"
  },
  "devDependencies": {
    "@types/jest": "^27.5.2",
    "@types/node": "10.17.27",
    "@types/prettier": "2.6.0",
    "jest": "^27.5.1",
    "lerna": "^10.0.1",
    "ts-jest": "^27.1.4",
    "ts-node": "^10.9.1",
    "typescript": "~3.9.7"
  },
  "dependencies": {
    "@types/aws-lambda": "^8.10.53",
    "aws-cdk-lib": "2.39.0",
    "aws-lambda": "^1.0.7",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
